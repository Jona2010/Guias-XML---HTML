# Base de datos MySQL
DB_HOST=tu-host-mysql
DB_PORT=3306
DB_NAME=tu-base-de-datos
DB_USER=tu-usuario
DB_PASS=tu-contrasena

# Mantén false si tu proveedor MySQL no usa SSL.
# Usa true solo si el servidor exige conexión TLS.
DB_SSL=false

# Solo para ejecución local con: npm start
PORT=3000
NODE_ENV=development
